# Shared secret; must match TRIAGE_SHARED_SECRET in backend/.env
TRIAGE_SHARED_SECRET=change-me

# LLM provider (OpenAI-compatible). Leave empty to use the keyword fallback classifier.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint (Azure, vLLM, Ollama, ...)
OPENAI_BASE_URL=
LLM_TIMEOUT_MS=15000

PORT=3001
