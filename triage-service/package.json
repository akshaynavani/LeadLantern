{
  "name": "leadlantern-triage-service",
  "version": "0.1.0",
  "private": true,
  "description": "LangChain-powered CRM task classifier for LeadLantern, deployed as an AWS Lambda.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "serverless deploy"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/openai": "^0.4.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.2",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.54.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
